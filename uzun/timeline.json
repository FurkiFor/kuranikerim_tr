     "text": "Bir gemi delindi.",
     "q": false,
     "start": 290.40999999999997,
     "end": 292.21
    },
    {
     "text": "Bir çocuk öldü.",
     "q": false,
     "start": 292.21,
     "end": 294.085
    },
    {
     "text": "Bir duvar, onları misafir etmeyenlerin",
     "q": false,
     "start": 294.085,
     "end": 297.1096268656716
    },
    {
     "text": "şehrinde onarıldı.",
     "q": false,
     "start": 297.1096268656716,
     "end": 298.90999999999997
    },
    {
     "text": "Şimdi cevaplar.",
     "q": false,
     "start": 298.90999999999997,
     "end": 300.74999999999994
    }
   ],
   "ref": null
  },
  {
   "i": 20,
   "bolum": "Geminin cevabı",
   "start": 302.74999999999994,
   "end": 317.5899999999999,
   "caps": [
    {
     "text": "Önce gemi.",
     "q": false,
     "start": 302.74999999999994,
     "end": 304.30499999999995
    },
    {
     "text": "Hızır'ın açıklaması Kur'an'da şöyle geçer:",
     "q": false,
     "start": 304.30499999999995,
     "end": 307.3153940886699
    },
    {
     "text": "Gemi, denizde çalışan birkaç yoksula aitti;",
     "q": true,
     "start": 307.3153940886699,
     "end": 310.58756157635463
    },
    {
     "text": "onu kusurlu kılmak istedim, çünkü peşlerinde",
     "q": true,
     "start": 310.58756157635463,
     "end": 313.72884236453194
    },
    {
     "text": "her sağlam gemiye zorla el koyan bir hükümdar vardı.",
     "q": true,
     "start": 313.72884236453194,
     "end": 317.5899999999999
    }
   ],
   "ref": "79. ayet"
  },
  {
   "i": 21,
   "bolum": "Geminin cevabı",
   "start": 318.0899999999999,
   "end": 331.5899999999999,
   "caps": [
    {
     "text": "Demek ki o gemi, kusurlu olduğu için",
     "q": false,
     "start": 318.0899999999999,
     "end": 320.78041095890404
    },
    {
     "text": "sahiplerinin elinde kaldı.",
     "q": false,
     "start": 320.78041095890404,
     "end": 322.99999999999994
    },
    {
     "text": "Yoksulların geçim kapısını koruyan şey, ondaki",
     "q": false,
     "start": 322.99999999999994,
     "end": 326.13059701492534
    },
    {
     "text": "o delikti.",
     "q": false,
     "start": 326.1305970149253,
     "end": 327.19499999999994
    },
    {
     "text": "Hazreti Musa deliği gördü.",
     "q": false,
     "start": 327.19499999999994,
     "end": 329.29499999999996
    },
    {
     "text": "Arkadan gelen hükümdarı göremedi.",
     "q": false,
     "start": 329.2949999999999,
     "end": 331.5899999999999
    }
   ],
   "ref": null
  },
  {
   "i": 22,
   "bolum": "Çocuğun cevabı",
   "start": 333.5899999999999,
   "end": 352.5799999999999,
   "caps": [
    {
     "text": "Sonra çocuk.",
     "q": false,
     "start": 333.5899999999999,
     "end": 335.50999999999993
    },
    {
     "text": "Kıssanın en zor cevabı budur:",
     "q": false,
     "start": 335.50999999999993,
     "end": 337.9024999999999
    },
    {
     "text": "Oğlana gelince; onun ana babası inanmış kimselerdi.",
     "q": true,
     "start": 337.9024999999999,
     "end": 342.32499999999993
    },
    {
     "text": "Çocuğun onları azdırmasından ve inkara",
     "q": true,
     "start": 342.32499999999993,
     "end": 344.65164383561637
    },
    {
     "text": "sürüklemesinden korkmuştuk.",
     "q": true,
     "start": 344.65164383561637,
     "end": 346.67999999999995
    },
    {
     "text": "Rablerinin o çocuktan daha temiz ve onlara",
     "q": true,
     "start": 346.6799999999999,
     "end": 349.26877551020397
    },
    {
     "text": "daha çok merhamet eden birini vermesini istedik.",
     "q": true,
     "start": 349.268775510204,
     "end": 352.5799999999999
    }
   ],
   "ref": "80-81. ayetler"
  },
  {
   "i": 23,
   "bolum": "Çocuğun cevabı",
   "start": 353.0799999999999,
   "end": 368.1599999999999,
   "caps": [
    {
     "text": "Bunu kendi aklımızla tartmak kolay değil.",
     "q": false,
     "start": 353.0799999999999,
     "end": 356.2349999999999
    },
    {
     "text": "Kur'an da bunu gizlemez:",
     "q": false,
     "start": 356.2349999999999,
     "end": 358.08335443037964
    },
    {
     "text": "bir peygamber bile o an buna dayanamamıştır.",
     "q": false,
     "start": 358.0833544303797,
     "end": 361.44999999999993
    },
    {
     "text": "Bize anlatılan, olayın hükmü değil;",
     "q": false,
     "start": 361.44999999999993,
     "end": 363.96624999999995
    },
    {
     "text": "görünenin ardında bizim bilmediğimiz bir",
     "q": false,
     "start": 363.96624999999995,
     "end": 366.42258928571425
    },
    {
     "text": "bilginin bulunduğudur.",
     "q": false,
     "start": 366.4225892857142,
     "end": 368.1599999999999
    }
   ],
   "ref": null
  },
  {
   "i": 24,
   "bolum": "Duvarın cevabı",
   "start": 370.1599999999999,
   "end": 393.3599999999999,
   "caps": [
    {
     "text": "Ve duvar.",
     "q": false,
     "start": 370.1599999999999,
     "end": 371.7899999999999
    },
    {
     "text": "Duvar ise, şehirde iki yetim erkek çocuğa aitti.",
     "q": true,
     "start": 371.7899999999999,
     "end": 375.9199999999999
    },
    {
     "text": "Duvarın altında onların bir hazinesi vardı;",
     "q": true,
     "start": 375.9199999999999,
     "end": 378.8079518072288
    },
    {
     "text": "babaları da iyi bir kimseydi.",
     "q": true,
     "start": 378.80795180722885,
     "end": 381.0199999999999
    },
    {
     "text": "Rabbin onların erginlik çağına ulaşmasını ve",
     "q": true,
     "start": 381.0199999999999,
     "end": 383.7298684210526
    },
    {
     "text": "Rabbinden bir rahmet olarak hazinelerini",
     "q": true,
     "start": 383.7298684210525,
     "end": 386.1988596491227
    },
    {
     "text": "çıkarmalarını istedi.",
     "q": true,
     "start": 386.1988596491227,
     "end": 387.8849999999999
    },
    {
     "text": "Ben bunları kendiliğimden yapmadım.",
     "q": true,
     "start": 387.88499999999993,
     "end": 389.99499999999995
    },
    {
     "text": "İşte dayanamadığın işlerin içyüzleri budur.",
     "q": true,
     "start": 389.9949999999999,
     "end": 393.3599999999999
    }
   ],
   "ref": "82. ayet"
  },
  {
   "i": 25,
   "bolum": "Duvarın cevabı",
   "start": 393.8599999999999,
   "end": 406.5799999999999,
   "caps": [
    {
     "text": "Babaları iyi bir kimseydi.",
     "q": false,
     "start": 393.8599999999999,
     "end": 396.0749999999999
    },
    {
     "text": "İki yetimin hakkı, onlar büyüyene kadar o",
     "q": false,
     "start": 396.0749999999999,
     "end": 398.91233766233756
    },
    {
     "text": "duvarın altında saklandı.",
     "q": false,
     "start": 398.91233766233756,
     "end": 400.9299999999999
    },
    {
     "text": "Kasaba halkı onları misafir etmemişti;",
     "q": false,
     "start": 400.9299999999999,
     "end": 403.6265909090908
    },
    {
     "text": "ama duvar o halk için doğrultulmamıştı.",
     "q": false,
