     "end": 464.53473684210513
    },
    {
     "text": "seksen ikinci ayetine kadar anlatılır.",
     "q": false,
     "start": 464.53473684210513,
     "end": 467.58999999999986
    },
    {
     "text": "Ayetleri Diyanet mealinden okuduk.",
     "q": false,
     "start": 467.58999999999986,
     "end": 470.1399999999999
    },
    {
     "text": "Bir sonraki kıssada hangisini anlatalım?",
     "q": false,
     "start": 470.1399999999999,
     "end": 472.6149999999999
    },
    {
