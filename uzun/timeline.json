   "end": 436.0699999999999,
   "caps": [
    {
     "text": "Hazreti Musa ise bir peygamberdi.",
     "q": false,
     "start": 419.9799999999999,
     "end": 423.1099999999999
    },
    {
     "text": "Yine de üç olayın üçünde yalnızca görüneni gördü.",
     "q": false,
     "start": 423.1099999999999,
     "end": 427.2149999999999
    },
    {
     "text": "Hızır ona en başta bunu söylemişti:",
     "q": false,
     "start": 427.2149999999999,
     "end": 429.46439393939386
    },
    {
     "text": "bilgice kavrayamadığın bir şeye nasıl dayanabilirsin?",
     "q": false,
     "start": 429.46439393939386,
     "end": 432.9249999999999
    },
    {
     "text": "Sabır, çoğu zaman bilmediğin yerde başlar.",
     "q": false,
     "start": 432.9249999999999,
     "end": 436.0699999999999
    }
   ],
   "ref": "68. ayet"
  },
  {
   "i": 28,
   "bolum": "Kapanış",
   "start": 436.5699999999999,
   "end": 452.2899999999999,
   "caps": [
    {
     "text": "Belki senin hayatında da delinmiş bir gemi var.",
     "q": false,
     "start": 436.5699999999999,
     "end": 440.40499999999986
    },
    {
     "text": "Elinden alınan bir şey.",
     "q": false,
     "start": 440.40499999999986,
     "end": 442.11499999999984
    },
    {
     "text": "Karşılığını göremediğin bir emek.",
     "q": false,
     "start": 442.1149999999999,
     "end": 444.5749999999999
    },
    {
     "text": "Bu kıssa sana her şeyin sebebini söylemez.",
     "q": false,
     "start": 444.5749999999999,
     "end": 447.6249999999999
    },
    {
     "text": "Ama şunu hatırlatır:",
     "q": false,
     "start": 447.6249999999999,
     "end": 449.1586986301369
    },
    {
     "text": "gördüğün, hikâyenin tamamı olmayabilir.",
     "q": false,
     "start": 449.1586986301369,
     "end": 452.2899999999999
    }
   ],
   "ref": null
  },
  {
   "i": 29,
   "bolum": "Kapanış",
   "start": 452.78999999999985,
   "end": 460.6399999999999,
   "caps": [
    {
     "text": "O yüzden şimdi kendine bir daha sor:",
     "q": false,
     "start": 452.78999999999985,
     "end": 455.24312499999985
    },
    {
     "text": "Başına gelenin sebebini bilmiyor olman, bir",
     "q": false,
     "start": 455.24312499999985,
     "end": 458.1255468749998
    },
    {
     "text": "sebebi olmadığı anlamına mı gelir?",
     "q": false,
     "start": 458.1255468749998,
     "end": 460.6399999999998
    }
   ],
   "ref": null
  },
