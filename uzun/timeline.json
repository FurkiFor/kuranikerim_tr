   "start": 408.5799999999999,
   "end": 419.4799999999999,
   "caps": [
    {
     "text": "Hızır'ın son sözüne dikkat et:",
     "q": false,
     "start": 408.5799999999999,
     "end": 410.66697368421046
    },
    {
     "text": "Ben bunları kendiliğimden yapmadım.",
     "q": false,
     "start": 410.66697368421046,
     "end": 413.24499999999995
    },
    {
     "text": "Bunlar, kimsenin kendi başına verebileceği",
     "q": false,
     "start": 413.24499999999995,
     "end": 415.8308571428571
    },
    {
     "text": "kararlar değildi.",
     "q": false,
     "start": 415.8308571428571,
     "end": 417.17999999999995
    },
    {
     "text": "Ona öğretilen bir ilimle oldu.",
     "q": false,
     "start": 417.17999999999995,
     "end": 419.47999999999996
    }
